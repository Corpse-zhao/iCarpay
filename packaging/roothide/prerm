#!/bin/sh
# iCarpay prerm (roothide) —— 卸载前停掉蓝牙守护进程，把蓝牙还给系统
set -e

JB="$(pwd)"
if [ ! -d "$JB/Applications" ]; then
    if [ -n "$JBROOT" ] && [ -d "$JBROOT/Applications" ]; then
        JB="$JBROOT"
    elif [ -d /var/jb/Applications ]; then
        JB="/var/jb"
    fi
fi

PLIST="$JB/Library/LaunchDaemons/ch.ringwald.BTstack.plist"
BLUETOOTHD="/System/Library/LaunchDaemons/com.apple.bluetoothd.plist"

for t in "$JB/usr/bin/launchctl" "$JB/bin/launchctl" /bin/launchctl /usr/bin/launchctl; do
    if [ -x "$t" ]; then
        if [ -f "$PLIST" ]; then
            "$t" unload "$PLIST" 2>/dev/null || true
        fi
        # 接管期间 bluetoothd 是被 bootout 掉的，卸载时必须 enable + bootstrap
        # 才能把它还给系统 —— 只 unload/load 是拉不回来的。
        "$t" enable system/com.apple.bluetoothd 2>/dev/null || true
        "$t" bootstrap system "$BLUETOOTHD" 2>/dev/null || true
        "$t" load "$BLUETOOTHD" 2>/dev/null || true
        break
    fi
done

# 让系统重新接管蓝牙，避免卸载后蓝牙仍被 BTstack 占用
# 不用 `command -v killall`：dpkg 的执行环境 PATH 往往是空的，探不到。
for k in "$JB/usr/bin/killall" "$JB/bin/killall" /usr/bin/killall /bin/killall; do
    if [ -x "$k" ]; then
        "$k" -9 BTdaemon 2>/dev/null || true
        break
    fi
done
rm -f /tmp/BTstack 2>/dev/null || true

exit 0
